# ─────────────────────────────────────────────────────────────
# Gastro_Hub — variáveis de ambiente (copie para .env)
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=gastrohub
DB_PASSWORD=gastrohub
DB_NAME=gastrohub
DB_SSL=false
# Chave usada pelo pgcrypto para cifrar dados sensíveis em repouso (LGPD).
# Em produção: gerar com `openssl rand -hex 32` e guardar em cofre de segredos.
DB_ENCRYPTION_KEY=dev-only-change-me-0123456789abcdef

# Redis (cache de sessão / fallback de resiliência)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SESSION_TTL=3600

# RabbitMQ (mensageria assíncrona — usado a partir da Fase 2)
RABBITMQ_URL=amqp://gastrohub:gastrohub@localhost:5672

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=1209600

# Rate limiting (API Gateway / BFF)
THROTTLE_TTL=60
THROTTLE_LIMIT=120
